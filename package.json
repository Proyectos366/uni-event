{
  "name": "uni-event",
  "description": "Sistema de gestion academica unerg",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-dev.mjs sqlite",
    "dev:neon": "node scripts/run-dev.mjs postgresql",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:seed": "npm run prisma:seed:sqlite",
    "prisma:seed:sqlite": "node scripts/prisma-seed.mjs sqlite",
    "prisma:seed:postgres": "node scripts/prisma-seed.mjs postgresql",
    "db:push": "prisma db push",
    "db:push:postgres": "prisma db push --config prisma.postgresql.config.mjs",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:postgres": "prisma migrate dev --config prisma.postgresql.config.mjs",
    "db:migrate:deploy:postgres": "prisma migrate deploy --config prisma.postgresql.config.mjs",
    "db:migrate:resolve": "prisma migrate resolve",
    "db:studio": "prisma studio",
    "db:studio:postgres": "prisma studio --config prisma.postgresql.config.mjs",
    "db:seed:postgres": "prisma db seed --config prisma.postgresql.config.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@prisma/adapter-libsql": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.13",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.1",
    "typescript": "^5.7.0"
  }
}
